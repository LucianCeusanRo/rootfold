# Lab defaults only — change these before any real deployment.
ROOTFOLD_DATABASE_URL=sqlite:///./data/rootfold.db
ROOTFOLD_JWT_SECRET=change-me-to-a-long-random-string
ROOTFOLD_JWT_EXPIRE_MINUTES=480
ROOTFOLD_ADMIN_USERNAME=admin
ROOTFOLD_ADMIN_PASSWORD=changeme
ROOTFOLD_WEBHOOK_KEY=lab-webhook-key
ROOTFOLD_RECOVERY_SWEEP_SECONDS=300
ROOTFOLD_SWEEP_INTERVAL_SECONDS=15
ROOTFOLD_LOG_LEVEL=INFO

# Optional NetBox import (leave empty to use a recorded fixture in lab mode)
ROOTFOLD_NETBOX_URL=
ROOTFOLD_NETBOX_TOKEN=
ROOTFOLD_NETBOX_FIXTURE=

# Optional ticket exporters. Empty means dry-run preview only.
ROOTFOLD_JIRA_URL=
ROOTFOLD_JIRA_USER=
ROOTFOLD_JIRA_TOKEN=
ROOTFOLD_JIRA_PROJECT=NOC
ROOTFOLD_JIRA_ISSUE_TYPE=Incident
ROOTFOLD_SNOW_URL=
ROOTFOLD_SNOW_USER=
ROOTFOLD_SNOW_PASSWORD=

# Monthly availability SLA threshold (percent)
ROOTFOLD_SLA_PERCENT=99.9
