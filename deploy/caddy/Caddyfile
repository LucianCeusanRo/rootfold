# Local TLS via Caddy's internal CA (stored under the caddy-data volume).
# After `docker compose up`, the CA cert is in the volume at
# /data/caddy/pki/authorities/local/root.crt — install it only on lab machines.
{
	auto_https disable_redirects
}

http://:80 {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	handle /healthz {
		reverse_proxy api:8000
	}
	handle {
		redir https://{host}:8443{uri}
	}
}

https://:443 {
	tls internal
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
		-Server
	}
	reverse_proxy api:8000
	log {
		output stdout
		format json
	}
}
